<Window x:Class="Byterake.App.Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Byterake" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <StackPanel Margin="26,24,26,22">
        <TextBlock x:Name="TitleText" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="BodyText" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource Muted}"/>
        </ScrollViewer>
        <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"/>
    </StackPanel>
</Window>
