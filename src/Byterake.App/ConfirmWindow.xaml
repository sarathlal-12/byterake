<Window x:Class="Byterake.App.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm cleanup" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <StackPanel Margin="26,24,26,22">
        <TextBlock x:Name="Headline" Style="{StaticResource H2}" FontSize="22" TextWrapping="Wrap"/>
        <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                   Text="Only the files counted here are touched. Files in use are skipped and listed when the clean finishes."/>

        <Border Background="{DynamicResource Surface2}" CornerRadius="12" Padding="16" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Free now" Style="{StaticResource MutedText}" FontSize="12"/>
                    <TextBlock x:Name="FreeBefore" Style="{StaticResource Big}" FontSize="22"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="→" FontSize="22" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="16,0"/>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Text="Free right after" Style="{StaticResource MutedText}" FontSize="12" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="FreeAfter" Style="{StaticResource Big}" FontSize="22" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock x:Name="BinNote" Style="{StaticResource MutedText}" FontSize="12.5" Margin="2,8,0,0"/>

        <TextBlock Text="What will be cleaned" FontWeight="SemiBold" Margin="0,16,0,6"/>
        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Lines">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource Muted}" Margin="0,2" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border x:Name="ExtraNoteBox" Background="{DynamicResource AmberSoft}" CornerRadius="10" Padding="12,10" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ExtraNote" TextWrapping="Wrap" Foreground="{DynamicResource AmberText}" FontSize="13"/>
        </Border>

        <TextBlock Text="How to remove" FontWeight="SemiBold" Margin="0,18,0,8"/>
        <RadioButton x:Name="ModeRecycle" Style="{StaticResource Option}" GroupName="mode" IsChecked="True" Checked="Mode_Changed" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Move to Recycle Bin" FontWeight="SemiBold"/>
                <TextBlock Text="Recommended. You can restore anything from the Recycle Bin later." Style="{StaticResource MutedText}"/>
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="ModePermanent" Style="{StaticResource Option}" GroupName="mode" Checked="Mode_Changed">
            <StackPanel>
                <TextBlock Text="Delete permanently" FontWeight="SemiBold" Foreground="{DynamicResource DangerText}"/>
                <TextBlock Text="Frees space straight away. Cannot be undone. You will be asked again." Style="{StaticResource MutedText}"/>
            </StackPanel>
        </RadioButton>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Style="{StaticResource Ghost}" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="Go" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="Go_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
